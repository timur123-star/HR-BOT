# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Telegram user id рекрутера, у которого будет доступ к admin-командам.
ADMIN_USER_ID=

# ---- Groq (LLM) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- PostgreSQL ----
DATABASE_URL=postgres://hrbot:hrbot@localhost:5432/hrbot

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Google Sheets (главная фича) ----
# JSON service-account целиком (одной строкой) либо путь к файлу.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_SHEET_ID=

# ---- Email (опционально, можно отключить) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HR Bot <noreply@example.com>"
RECRUITER_EMAIL=

# ---- Runtime ----
LOG_LEVEL=info
SESSION_TTL_SECONDS=3600
MIN_ANSWER_LENGTH=20
# HTTP health-эндпоинт для Docker healthcheck / k8s liveness probe (/health).
HEALTH_PORT=8081

# ---- Webhook (опционально, для production scale) ----
# Если WEBHOOK_URL задан — бот работает в режиме webhook, иначе long-polling.
# URL должен быть публично доступным (https), Telegram отправит туда POST-запрос с апдейтом.
WEBHOOK_URL=
WEBHOOK_PORT=8080
# Опциональный секрет, чтобы Telegram передавал его в заголовке (защита от подделки).
WEBHOOK_SECRET=
